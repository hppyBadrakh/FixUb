{
  "name": "fixub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:reset": "tsx scripts/db/reset.ts",
    "db:go-live": "tsx scripts/db/go-live.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swr": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.15",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "wrangler": "4.156.1"
  },
  "engines": {
    "node": ">=22"
  }
}
