# FixUB environment variables.
#
# Local development:   copy this file to .env.local   (read by `npm run dev` and the db:* scripts)
# Workers preview:     copy the same values to .dev.vars (read by `npm run preview`)
# Production:          set them as secrets in the Cloudflare dashboard (only A does this)
#
# Never commit .env.local or .dev.vars. Without DATABASE_URL the app only shows a
# "server not configured" page.

# --- Database ---------------------------------------------------------------------------
# Neon: your own branch's *pooled* connection string (A sends it to you privately), e.g.
#   postgresql://<user>:<password>@<endpoint>-pooler.ap-southeast-1.aws.neon.tech/<db>?sslmode=require
# Local Docker (`npm run db:up`): use the value below.
DATABASE_URL=postgres://fixub:fixub@localhost:54329/fixub

# Only for a plain Postgres behind Neon's WebSocket proxy (local Docker, CI).
# Leave EMPTY when DATABASE_URL points at Neon.
DATABASE_WS_PROXY=localhost:54330/v1

# --- Sign-in (Better Auth) --------------------------------------------------------------
# Signs session cookies. Generate your own:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters

# The site's public origin, no trailing slash. Production: https://<your-worker>.workers.dev
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID,
# type "Web application"). Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# Leave empty to run without Google sign-in (the login page then says it isn't configured).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "true" makes this a demonstration deployment: /login offers one-click sample users (citizen,
# admin, staff) and screens say the data is sample data. For development and CI only. On the
# real site leave it out: the server then refuses sample sign-ins.
DEMO_LOGIN=true

# "true": a new report is only public once an admin has reviewed it (set its priority).
# Leave empty to publish reports the moment they are filed.
REVIEW_BEFORE_PUBLIC=

# The map's style (a MapLibre style JSON URL), read when the site is BUILT. Empty = OpenFreeMap's
# free public server, which has no service guarantee: set a provider's URL for real traffic.
NEXT_PUBLIC_MAP_STYLE_URL=

# Google emails that are always admins, comma-separated. This is how the first admin gets in
# on the real site; everyone else is given access on /admin/users.
ADMIN_EMAILS=
