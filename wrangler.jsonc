{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fixub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Must match "name" above, or Cloudflare rejects the deploy (error 10143).
      "binding": "WORKER_SELF_REFERENCE",
      "service": "fixub"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Photos (Cloudflare R2), read in src/server/photos.ts as env.PHOTOS. `npm run dev` gets a
  // simulated bucket on disk (.wrangler/), never the real one. Photos stored in Postgres before
  // the bucket existed (table photo_blobs) move here the first time each is read.
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "fixub-photos" }]
}
