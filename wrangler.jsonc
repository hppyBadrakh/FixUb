{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fixub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Must match "name" above, or Cloudflare rejects the deploy (error 10143).
      "binding": "WORKER_SELF_REFERENCE",
      "service": "fixub"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Photos (Cloudflare R2), read in src/server/photos.ts as env.PHOTOS.
  // For now the binding exists only in the "dev" environment, which `npm run dev` uses with a
  // local simulated bucket (files under .wrangler/). Production gets it once R2 is enabled on
  // the Cloudflare account and the bucket exists: then move "r2_buckets" to the top level.
  // Until then the deployed site keeps photo bytes in Postgres (table photo_blobs); once the
  // binding exists, new photos go to R2 and old ones move there the first time they are read.
  "env": {
    "dev": {
      "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "fixub-photos" }]
    }
  }
}
